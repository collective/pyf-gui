{
	"name": "pyf-gui",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:presenter": "PRESENTER=1 playwright test --project=chromium",
		"prepare": "husky"
	},
	"devDependencies": {
		"@playwright/test": "^1.58.0",
		"@sveltejs/adapter-node": "^5.2.12",
		"@sveltejs/kit": "^2.49.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"bootstrap": "^5.3.8",
		"husky": "^9.1.7",
		"mdsvex": "^0.12.6",
		"sass": "^1.86.0",
		"svelte": "^5.17.3",
		"svelte-check": "^4.1.4",
		"tslib": "^2.8.1",
		"typescript": "^5.7.3",
		"vite": "^6.0.7"
	},
	"dependencies": {
		"typesense": "^2.1.0"
	}
}
